{
  "manifest_version": 3,
  "name": "Steroid",
  "version": "1.0.0",
  "description": "A command palette for Chrome, inspired by IntelliJ's Shift+Shift.",
  "permissions": [
    "tabs",
    "scripting",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Steroid - Press Shift+Shift to open"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
